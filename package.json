{
  "name": "gangsik-club",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server/index.js & vite client --host",
    "build": "vite build client --outDir ../dist --emptyOutDir",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js test/e2e/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "test:ui": "node test/ui/smoke.mjs",
    "check": "npm run build && npm run test:unit && npm run test:ui"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "three": "0.160.0",
    "vite": "^5.4.11"
  }
}